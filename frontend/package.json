{
  "name": "babysitter",
  "productName": "Babysitter",
  "version": "0.1.0",
  "description": "Desktop app for babysitter, the GitHub pull request watcher",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "build:daemon": "node ./scripts/build-daemon.mjs",
    "prestart": "npm run build:daemon",
    "start": "electron-forge start",
    "prepackage": "npm run build:daemon",
    "package": "electron-forge package",
    "premake": "npm run build:daemon",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "typecheck": "tsc --noEmit",
    "lint": "vp lint --type-aware",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "test": "NODE_OPTIONS=--no-webstorage vp test run",
    "test:coverage": "NODE_OPTIONS=--no-webstorage vp test run --coverage"
  },
  "keywords": [],
  "author": {
    "name": "Deivid Fortuna",
    "email": "deividfortuna@gmail.com"
  },
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.0-alpha.10",
    "@electron-forge/maker-deb": "^8.0.0-alpha.10",
    "@electron-forge/maker-dmg": "^8.0.0-alpha.10",
    "@electron-forge/maker-rpm": "^8.0.0-alpha.10",
    "@electron-forge/maker-squirrel": "^8.0.0-alpha.10",
    "@electron-forge/maker-zip": "^8.0.0-alpha.10",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.0-alpha.10",
    "@electron-forge/plugin-fuses": "^8.0.0-alpha.10",
    "@electron-forge/plugin-vite": "^8.0.0-alpha.10",
    "@electron/fuses": "^2.0.0",
    "@shadcn/lint": "^0.2.0",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "electron": "44.4.3",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "jsdom": "^30.1.0",
    "msw": "^2.11.6",
    "tailwindcss": "^4.1.0",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0-rc.1",
    "vitest": "5.0.1",
    "vite-plus": "1.0.0-rc.1"
  },
  "dependencies": {
    "@fontsource-variable/mona-sans": "^5.3.0",
    "@pierre/diffs": "^1.5.1",
    "@tanstack/react-query": "^5.103.1",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "electron-squirrel-startup": "^1.0.1",
    "electron-updater": "~6.8.9",
    "lucide-react": "^1.47.0",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.6.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "allowScripts": {
    "electron-winstaller@5.4.4": true,
    "msw@2.15.0": true,
    "fsevents@2.3.3": true,
    "fs-xattr@0.3.1": true,
    "macos-alias@0.2.12": true
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0-rc.1",
    "vitest": "5.0.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.19.1",
      "onFail": "download"
    }
  }
}
