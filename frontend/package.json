{
  "name": "babysitter",
  "productName": "Babysitter",
  "version": "0.1.0",
  "description": "Desktop app for babysitter, the GitHub pull request watcher",
  "main": "dist-electron/main.cjs",
  "private": true,
  "scripts": {
    "build:daemon": "node ./scripts/build-daemon.mjs",
    "build:ghostty-wasm": "bash ./scripts/build-libghostty-wasm.sh",
    "prestart": "pnpm run build:daemon",
    "start": "node ./scripts/dev.mjs",
    "package": "node ./scripts/build-desktop.mjs --dir",
    "make": "node ./scripts/build-desktop.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "vp lint --type-aware",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "test": "cross-env NODE_OPTIONS=--no-webstorage vp test run",
    "test:coverage": "cross-env NODE_OPTIONS=--no-webstorage vp test run --coverage"
  },
  "keywords": [],
  "author": {
    "name": "Deivid Fortuna",
    "email": "deividfortuna@gmail.com"
  },
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "@shadcn/lint": "^0.2.0",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "cross-env": "^10.1.0",
    "electron": "44.4.5",
    "electron-builder": "26.16.1",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "jsdom": "^30.1.1",
    "msw": "^2.11.6",
    "tailwindcss": "^4.1.0",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0-rc.1",
    "vite-plus": "1.0.0-rc.1",
    "vitest": "5.0.2"
  },
  "dependencies": {
    "@fontsource-variable/mona-sans": "^5.3.0",
    "@pierre/diffs": "^1.5.1",
    "@tanstack/react-query": "^5.103.2",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "electron-updater": "~6.8.9",
    "lucide-react": "^1.48.0",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.6.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0",
      "onFail": "download"
    }
  }
}
